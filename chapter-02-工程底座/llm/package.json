{
  "name": "root",
  "private": true,
  "workspaces": ["clients/*", "services/*", "packages/*"],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev:app": "turbo run dev --parallel --filter=@autix/user-system --filter=@autix/chat --filter=@autix/chat-web",
    "dev": "turbo run dev --parallel --filter=@autix/chat --filter=@autix/chat-web",
    "dev:chat-web": "turbo run dev --filter=@autix/chat-web",
    "dev:chat": "turbo run dev --filter=@autix/chat",
    "dev:user": "turbo run dev --filter=@autix/user-system",
    "dev:admin": "turbo run dev --filter=@autix/user",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.8.20",
    "wait-on": "^9.0.5"
  }
}
