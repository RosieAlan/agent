# Use independent strong credentials; chmod 600 .env.production.
RELEASE_TAG=20261110-commitsha
COMPOSE_PROFILES=knowledge,search
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
DB_NAME=ops_assistant
DB_USER=ops_app
DB_PASSWORD=replace-with-random-app-password
DB_HOST=mysql
DB_PORT=3306
OPENAI_MODEL=qwen3.8-flash
OPENAI_API_KEY=replace-with-authorized-provider-key
OPENAI_BASE_URL=https://replace-with-authorized-provider/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
PG_ADMIN_PASSWORD=replace-with-random-pg-admin-password
PG_DATABASE=ops_assistant_knowledge
PG_APP_USER=ops_knowledge_app
PG_APP_PASSWORD=replace-with-random-url-safe-password
# Enable knowledge profile and set URL together. Percent encode URL password.
KNOWLEDGE_DATABASE_URL=
ELASTICSEARCH_URL=http://search:9200
RERANK_URL=
RERANK_MODEL=
