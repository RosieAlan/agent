      "threshold": 20,
      "expected": {"low_stock_count": 1, "available_by_store": {"OPS-GZ": 28, "OPS-SZ": 6}}
    },
    {
      "id": "inventory-threshold-30",
      "kind": "inventory",
      "sku": "OPS-EARBUDS-001",
      "threshold": 30,
      "expected": {"low_stock_count": 2, "available_by_store": {"OPS-GZ": 28, "OPS-SZ": 6}}
    },
    {
      "id": "inventory-not-found",
      "kind": "inventory",
      "sku": "EVAL-NOT-EXIST-001",
      "threshold": 20,
      "expected": {"low_stock_count": 0, "available_by_store": {}}
    },
    {
      "id": "route-inventory",
