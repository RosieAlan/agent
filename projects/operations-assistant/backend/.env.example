MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=your_database
APP_ENV=development
COMPANY_SSO_BASE_URL=https://your-company-test-server.example
COMPANY_SSO_PUBLIC_KEY=replace_with_company_login_public_key_base64
SESSION_ENCRYPTION_KEY=replace_with_generated_fernet_key
# 项目日常查询账号；数据库名固定为本项目独立库。
DATABASE_URL=postgresql+psycopg://operations_app:replace_me@127.0.0.1:5432/operations_assistant
# 仅部署迁移和人工导入使用，应用查询无需此账号。
MIGRATION_DATABASE_URL=postgresql+psycopg://operations_migrator:replace_me@127.0.0.1:5432/operations_assistant
